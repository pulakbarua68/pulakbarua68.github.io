<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BKF Football</title>
<style>
body{margin:0;background:#0a2a12;color:white;text-align:center;font-family:sans-serif}
h1{color:yellow;font-size:38px;margin:5px}
#top{width:360px;margin:10px auto;display:flex;justify-content:space-between;align-items:center}
#top button{padding:8px 14px;border-radius:20px;border:2px solid white;font-weight:bold}
#box{width:360px;height:500px;background:green;margin:auto;border:4px solid yellow;border-radius:15px;position:relative;overflow:hidden}
#ball{width:26px;height:26px;background:white;border-radius:50%;position:absolute;left:167px;top:240px}
#goal{width:120px;height:12px;background:white;position:absolute;top:0;left:120px}
.btn{width:70px;height:70px;background:orange;border-radius:50%;border:2px solid white;color:white;font-weight:bold;margin:5px}
#bar{width:0%;height:15px;background:yellow}
#settingsPanel{display:none;position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:99;padding-top:40px}
</style>
</head>
<body>
<h1>BKF</h1>
<div id="top">
<button onclick="openSettings()" style="background:#2196F3;color:white">⚙️ Settings</button>
<button onclick="checkUpdate()" style="background:#4CAF50;color:white">🔄 Update</button>
</div>
<div style="width:90%;max-width:360px;height:15px;background:#333;margin:5px auto"><div id="bar"></div></div>
<div id="box">
<div id="goal"></div>
<div id="ball"></div>
<div id="settingsPanel">
<h2>⚙️ BKF Settings</h2>
<p>Sound: ON</p>
<p>Vibration: ON</p>
<p>Version: 1.2</p>
<button onclick="closeSettings()" style="padding:10px 20px;background:red;color:white;border-radius:10px">Close</button>
</div>
<div style="position:absolute;bottom:5px;width:100%">
<button class="btn" onclick="move(-15)">LEFT</button>
<button class="btn" onclick="shoot()">SHOOT</button>
<button class="btn" onclick="move(15)">RIGHT</button>
</div>
</div>
<h2 id="score">Goal: 0</h2>
<script>
let x=167,y=240,s=0,v=0;
let b=document.getElementById('ball');
let br=document.getElementById('bar');
function move(d){x+=d;if(x<0)x=0;if(x>334)x=334;b.style.left=x+'px';}
function shoot(){
v+=20;if(v>100)v=100;br.style.width=v+'%';
let t=setInterval(function(){
y-=10;b.style.top=y+'px';
if(y<20&&x>100&&x<220){s++;document.getElementById('score').innerHTML='Goal: '+s;y=240;clearInterval(t);
if(v>=100){alert('THUNDER SHOT! BKF GOAL!');v=0;br.style.width='0%';}
}
if(y<0){y=240;clearInterval(t);}
},25);
}
function openSettings(){document.getElementById('settingsPanel').style.display='block';}
function closeSettings(){document.getElementById('settingsPanel').style.display='none';}
function checkUpdate(){alert('Checking for Update... BKF Football v1.2 is Latest!');}
</script>
</body>
</html>
